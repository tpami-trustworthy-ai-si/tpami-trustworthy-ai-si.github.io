---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';
import { site } from '../config/site';
import { editors } from '../config/editors';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.title}: ${site.subtitle} — ${site.journalShort} Special Issue`,
  description = site.description,
} = Astro.props;

const canonical = site.url;

// Only advertise an OG image if the file actually exists in public/.
const ogFile = site.ogImage?.trim();
const ogExists =
  !!ogFile && fs.existsSync(path.join(process.cwd(), 'public', ogFile));
const ogUrl = ogExists ? new URL(withBase(ogFile), Astro.site).href : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${site.title}: ${site.subtitle}`,
  description: site.description,
  url: canonical,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'Periodical',
    name: site.journal,
    alternateName: site.journalShort,
    publisher: { '@type': 'Organization', name: 'IEEE Computer Society' },
  },
  editor: editors.map((e) => ({
    '@type': 'Person',
    name: e.name,
    affiliation: { '@type': 'Organization', name: e.affiliation },
  })),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#060814" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.journalShort} />
    <meta property="og:title" content={`${site.title}: ${site.subtitle}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta
      name="twitter:card"
      content={ogUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={`${site.title}: ${site.subtitle}`} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <script is:inline>
      // Apply the stored (or system) colour scheme before first paint.
      (function () {
        try {
          var stored = localStorage.getItem('si-theme');
          var dark =
            stored === 'dark' ||
            (!stored &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {
          /* localStorage unavailable — fall back to light */
        }
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>

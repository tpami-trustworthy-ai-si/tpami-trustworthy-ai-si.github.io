---
import { site } from '../config/site';
import { contact } from '../config/content';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

const hasEmail = Boolean(site.contactEmail.trim());

const shareUrl = site.url;
const xUrl = `https://x.com/intent/post?text=${encodeURIComponent(site.shareText)}&url=${encodeURIComponent(shareUrl)}`;
const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;

const shareBtn =
  'inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10';
---

<section
  id="contact"
  class="section bg-slate-50 dark:bg-ink-900"
  data-share-root
  data-share-url={shareUrl}
>
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader
          eyebrow={contact.eyebrow}
          title={contact.title}
          lead={hasEmail ? contact.body : 'For manuscript preparation and submission requirements, please refer to the TPAMI author guidelines.'}
        />

        {hasEmail && (
          <div class="mt-6 card max-w-md">
            <p class="text-base font-semibold text-slate-900 dark:text-white">{site.contactName}</p>
            <a href={`mailto:${site.contactEmail}`} class="link-underline mt-3 inline-flex max-w-full items-start gap-2 text-sm" aria-label="Email the Guest Editorial Team">
              <Icon name="mail" class="mt-0.5 size-4 shrink-0" />
              <span class="break-all">{site.contactEmail}</span>
            </a>
          </div>
        )}
        <p class="mt-5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{contact.support}</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm">
          <a href={site.links.authorGuidelines} target="_blank" rel="noopener noreferrer" class="link-underline">TPAMI Author Guidelines</a>
          <a href={site.links.submission} target="_blank" rel="noopener noreferrer" class="link-underline">IEEE Submission Portal</a>
        </div>
      </div>

      <div>
        <div class="eyebrow" data-reveal>
          <span class="inline-block h-px w-6 bg-current opacity-60"></span>
          Help us spread the word
        </div>
        <h3 class="section-title !text-2xl" data-reveal>Share this call</h3>
        <p class="section-lead !text-base" data-reveal>
          The special issue depends on reaching the right authors. If you work in
          adversarial ML, vision security, or LLM safety, please pass it on.
        </p>

        <div class="mt-6 flex flex-wrap gap-2" data-reveal>
          <a href={xUrl} target="_blank" rel="noopener noreferrer" class={shareBtn}>
            <Icon name="x" class="size-3.5" />
            Share on X
          </a>
          <a
            href={linkedInUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={shareBtn}
          >
            <Icon name="linkedin" class="size-4" />
            Share on LinkedIn
          </a>
          <button type="button" class={shareBtn} data-copy={shareUrl}>
            <Icon name="link" class="size-4" />
            <span data-copy-label>Copy link</span>
          </button>
          <button type="button" class:list={[shareBtn, 'hidden']} data-share-native>
            <Icon name="arrow-up-right" class="size-4" />
            Share…
          </button>
        </div>

        <div
          class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-white/[0.03]"
          data-reveal
        >
          <p class="text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
            Suggested text
          </p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {site.shareText}
          </p>
          <button
            type="button"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 dark:text-accent-400"
            data-copy={`${site.shareText} ${shareUrl}`}
          >
            <Icon name="copy" class="size-4" />
            <span data-copy-label>Copy text and link</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

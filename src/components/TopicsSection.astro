---
import { topicAreas } from '../config/topics';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
---

<section id="topics" class="section bg-slate-50 dark:bg-ink-900">
  <div class="container-page">
    <SectionHeader eyebrow="Research areas" title="Topics of Interest"
      lead="Submissions should make clear technical contributions to visual intelligence, including visual foundation models, multimodal models, generative visual models, and embodied AI." />
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">Topics include, but are not limited to, the following areas.</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {topicAreas.map((area) => (
        <article class="card card-hover">
          <div class="flex items-start gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/15 dark:text-accent-400">
              <Icon name={area.icon} class="size-4.5" />
            </span>
            <h3 class="flex-1 pt-1 text-lg leading-snug font-semibold">{area.title}</h3>
            <span class="pt-1.5 font-mono text-xs text-slate-400" aria-hidden="true">{area.number}</span>
          </div>
          <ul class="mt-5 space-y-2.5 border-t border-slate-100 pt-5 dark:border-white/10">
            {area.items.map((item) => (
              <li class="flex gap-2.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-brand-500 dark:bg-accent-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

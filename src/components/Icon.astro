import type { HTMLAttributes } from 'astro/types';

/**
 * Inline SVG icons. Outline icons are stroked 24x24 paths; `x` and `linkedin`
 * are filled brand marks. Unknown names fall back to a neutral dot so a typo in
 * a config file never breaks the build.
 */
interface Props {
  name: string;
  class?: string;
  /** Passed through to aria-hidden / aria-label handling. */

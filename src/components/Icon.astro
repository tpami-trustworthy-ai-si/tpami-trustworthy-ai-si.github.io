const isBrand = name in BRAND;
const d = isBrand ? BRAND[name] : (OUTLINE[name] ?? OUTLINE.dot);
const a11y: HTMLAttributes<'svg'> = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true' };
---

{
  isBrand ? (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} {...a11y}>
      <path d={d} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      {...a11y}
    >
      <path d={d} />
    </svg>
  )
}

---
import Icon from './Icon.astro';

interface Props {
  value: string;
  /** Text shown on the button; defaults to "Copy". */
  label?: string;
  class?: string;
}

const { value, label = 'Copy', class: className } = Astro.props;
---

<div
  class:list={[
    'flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-2 pl-4 dark:border-white/10 dark:bg-white/5',
    className,
  ]}
>
  <code class="min-w-0 flex-[1_1_100%] font-mono text-sm break-words text-slate-800 dark:text-slate-200">
    {value}
  </code>
  <button
    type="button"
    data-copy={value}
    class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:bg-white/10"
  >
    <Icon name="copy" class="size-3.5" />
    <span data-copy-label aria-live="polite">{label}</span>
  </button>
</div>
